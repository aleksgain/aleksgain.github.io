---
import SEOMetadata from '../components/SEOMetadata.astro';
import StructuredData from '../components/StructuredData.astro';
import SEOMonitor from '../components/SEOMonitor.astro';
import personalData from '../data/personal.json';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'profile';
  canonicalUrl?: string;
}

const { 
  title, 
  description = "Alex Gain - Senior Cloud Engineer and DevSecOps Specialist with expertise in AWS, GCP, and Kubernetes",
  image = "/images/profile.jpg", 
  type = "website",
  canonicalUrl = Astro.url.href
} = Astro.props;

// Generate structured data for a person
const personSchema = {
  "name": "Alexey Gain",
  "jobTitle": "Senior Cloud Engineer / Technical Lead",
  "url": Astro.url.origin,
  "sameAs": [
    `https://www.linkedin.com/in/${personalData.linkedInUsername}`,
    `https://github.com/${personalData.githubUsername}`
  ],
  "knowsAbout": [
    "AWS", "Google Cloud Platform", "Kubernetes", "DevOps", "Cloud Security", 
    "Infrastructure as Code", "Terraform", "CI/CD", "SRE", "Docker"
  ]
};

// Generate structured data for the website
const websiteSchema = {
  "name": "Alex Gain - Personal Portfolio",
  "url": Astro.url.origin,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${Astro.url.origin}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="en" class="transition-colors scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    
    <SEOMetadata
      title={title}
      description={description}
      image={image}
      type={type}
      canonicalUrl={canonicalUrl}
    />
    
    <!-- Structured Data -->
    <StructuredData type="Person" data={personSchema} />
    <StructuredData type="WebSite" data={websiteSchema} />
    
    <!-- Favicons and Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Security Headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      img-src 'self' https://avatars.githubusercontent.com https://images.credly.com https://www.nasdaq.com https://templates.images.credential.net data:;
      script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com;
      style-src 'self' 'unsafe-inline';
      connect-src 'self' https://api.github.com https://cloudflareinsights.com;
      frame-src 'none';
      object-src 'none';
      base-uri 'self';
      form-action 'self';
      font-src 'self';
      manifest-src 'self';
      media-src 'self';
      worker-src 'self' blob:;
      " />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors">
    <slot />
    <SEOMonitor />
  </body>
</html>

<style is:global>
  /* Enhanced focus styles for accessibility */
  *:focus-visible {
    outline: 2px solid theme('colors.blue.500');
    outline-offset: 2px;
  }
  
  /* Smooth transitions for interactive elements */
  a, button {
    transition-property: color, background-color, border-color, transform, box-shadow;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Improve text readability */
  body {
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  
  /* Better scrollbar styling for webkit browsers */
  ::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  
  ::-webkit-scrollbar-track {
    background: theme('colors.gray.100');
  }
  
  .dark ::-webkit-scrollbar-track {
    background: theme('colors.gray.800');
  }
  
  ::-webkit-scrollbar-thumb {
    background: theme('colors.gray.400');
    border-radius: 5px;
  }
  
  .dark ::-webkit-scrollbar-thumb {
    background: theme('colors.gray.600');
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: theme('colors.gray.500');
  }
  
  .dark ::-webkit-scrollbar-thumb:hover {
    background: theme('colors.gray.500');
  }
</style> 
