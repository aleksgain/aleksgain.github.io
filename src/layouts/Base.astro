---
// src/layouts/Base.astro — the single page shell for the site.
// Merges the redesign's theme tokens and layout chrome with the SEO,
// structured data and security headers the old Layout.astro carried.
import SEOMetadata from '../components/SEOMetadata.astro';
import StructuredData from '../components/StructuredData.astro';
import SEOMonitor from '../components/SEOMonitor.astro';
import personalData from '../data/personal.json';

// Self-hosted webfonts (no third-party requests, so the CSP stays tight).
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'profile' | 'article';
  canonicalUrl?: string;
}

const {
  title,
  description = 'Alex Gain - Senior Cloud Engineer and DevSecOps Specialist with expertise in AWS, GCP, and Kubernetes',
  image = '/images/profile.jpg',
  type = 'website',
  canonicalUrl = Astro.url.href,
} = Astro.props;

const personSchema = {
  name: 'Alexey Gain',
  jobTitle: 'Senior Cloud Engineer / Technical Lead',
  url: Astro.url.origin,
  sameAs: [
    `https://www.linkedin.com/in/${personalData.linkedInUsername}`,
    `https://github.com/${personalData.githubUsername}`,
  ],
  knowsAbout: [
    'AWS', 'Google Cloud Platform', 'Kubernetes', 'DevOps', 'Cloud Security',
    'Infrastructure as Code', 'Terraform', 'CI/CD', 'SRE', 'Docker',
  ],
};

const websiteSchema = {
  name: 'Alex Gain - Personal Portfolio',
  url: Astro.url.origin,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${Astro.url.origin}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SEOMetadata
      title={title}
      description={description}
      image={image}
      type={type}
      canonicalUrl={canonicalUrl}
    />

    <StructuredData type="Person" data={personSchema} />
    <StructuredData type="WebSite" data={websiteSchema} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0b1221" />
    <meta name="generator" content={Astro.generator} />

    <!-- Security headers. Fonts are self-hosted, so font-src stays local ('self' + data: for Fontsource's base64 woff fallback).
         github.com is allowed for the profile avatar (it 302s to avatars.githubusercontent.com). -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="X-Frame-Options" content="DENY" />
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      img-src 'self' https://github.com https://avatars.githubusercontent.com https://images.credly.com https://www.nasdaq.com https://templates.images.credential.net data:;
      script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com;
      style-src 'self' 'unsafe-inline';
      connect-src 'self' https://api.github.com https://cloudflareinsights.com;
      frame-src 'none';
      object-src 'none';
      base-uri 'self';
      form-action 'self';
      font-src 'self' data:;
      manifest-src 'self';
      media-src 'self';
      worker-src 'self' blob:;
      " />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />

    <script is:inline>
      // Set the theme before first paint to avoid a flash.
      // Both flags are set: `data-theme` drives the design tokens below,
      // and the `dark` class keeps Tailwind's dark: variants working.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('theme'); } catch (e) {}
        var theme = saved || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        var root = document.documentElement;
        root.setAttribute('data-theme', theme);
        root.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>

  <body>
    <slot />
    <SEOMonitor />

    <style is:global>
      html, body { margin: 0; padding: 0; }

      html {
        --bg:#0b1221; --bg2:#111a2e; --card:#1b2437; --card2:#222d44;
        --line:rgba(255,255,255,.09); --line2:rgba(255,255,255,.16);
        --ink:#f2f5fa; --ink2:#a8b3c7; --ink3:#6f7c94;
        --accent:#a78bfa; --link:#60a5fa; --green:#34d399; --orange:#fb923c;
        --shadow:0 10px 26px rgba(0,0,0,.22);
      }
      html[data-theme="light"] {
        --bg:#f6f7f9; --bg2:#ffffff; --card:#ffffff; --card2:#f1f3f7;
        --line:rgba(12,20,36,.10); --line2:rgba(12,20,36,.18);
        --ink:#131a28; --ink2:#4f5a6e; --ink3:#8a94a6;
        --accent:#7c5cf0; --link:#2563eb; --green:#0f9f74; --orange:#d97406;
        --shadow:0 10px 26px rgba(12,20,36,.10);
      }

      body {
        background: var(--bg);
        color: var(--ink);
        font-family: Lato, "Helvetica Neue", Helvetica, sans-serif;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      a { color: var(--link); text-decoration: none; }
      a:hover { color: var(--accent); }
      ::selection { background: var(--accent); color: #0b1221; }
      .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }

      *:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      a, button { transition-property: color, background-color, border-color, transform, box-shadow; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1); }

      @keyframes wireIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

      /* ---- top bar ---- */
      .topbar {
        position: sticky; top: 0; z-index: 30;
        display: flex; align-items: center; gap: 20px;
        padding: 12px 28px;
        background: color-mix(in oklab, var(--bg) 88%, transparent);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid var(--line);
      }
      .topbar__brand { display: flex; align-items: baseline; gap: 10px; }
      .topbar__name { font-weight: 900; font-size: 17px; letter-spacing: -.3px; color: var(--ink); }
      .topbar__name:hover { color: var(--ink); }
      .topbar__host { font: 500 11px/1 "JetBrains Mono", monospace; color: var(--ink3); letter-spacing: .06em; }
      .topbar__spacer { flex: 1; }
      .topbar__actions { display: flex; align-items: center; gap: 8px; }
      .topbar__link { font-size: 13.5px; font-weight: 700; color: var(--ink2); padding: 7px 12px; border-radius: 7px; }
      .topbar__link:hover { background: var(--card); color: var(--ink); }
      .topbar__theme {
        cursor: pointer; width: 34px; height: 34px; display: grid; place-items: center;
        border: 1px solid var(--line2); background: var(--card); color: var(--ink2);
        border-radius: 8px; font-size: 14px; font-family: inherit;
      }
      .topbar__theme:hover { color: var(--ink); border-color: var(--accent); }

      /* ---- page shells ---- */
      .shell {
        max-width: 1240px; margin: 0 auto; padding: 34px 28px 80px;
        display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
        gap: 40px; align-items: start;
      }
      .shell--narrow {
        display: block; max-width: 820px;
        margin: 0 auto; padding: 40px 28px 90px;
      }

      /* ---- scrollbars ---- */
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: var(--bg2); }
      ::-webkit-scrollbar-thumb { background: var(--ink3); border-radius: 5px; }
      ::-webkit-scrollbar-thumb:hover { background: var(--ink2); }

      @media (max-width: 860px) {
        .topbar { padding: 11px 16px; gap: 12px; }
        .topbar__host { display: none; }
        .shell { grid-template-columns: minmax(0, 1fr); gap: 26px; padding: 22px 16px 64px; }
        .shell > aside { position: static !important; top: auto !important; }
        .shell--narrow { padding: 24px 16px 64px; }
        .feed__head h1 { font-size: 28px; }
        .feed__filters {
          top: 53px; margin: 0 -16px; padding: 10px 16px;
          overflow-x: auto; flex-wrap: nowrap; scrollbar-width: none;
        }
        .feed__filters::-webkit-scrollbar { display: none; }
        .feed__filters > button { flex: 0 0 auto; }
        .post { padding: 15px 16px; }
      }

      @media print {
        .topbar, .no-print { display: none !important; }
        body { background: #fff; color: #000; }
        .shell--narrow { padding: 0; max-width: none; }
      }
    </style>

    <script is:inline>
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-theme-toggle]');
        if (!btn) return;
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        root.classList.toggle('dark', next === 'dark');
        try { localStorage.setItem('theme', next); } catch (err) {}
        document.querySelectorAll('[data-theme-toggle]').forEach(function (el) {
          el.textContent = next === 'light' ? '☾' : '☀';
        });
      });

      // Match the button glyph to the theme picked before paint.
      (function () {
        var light = document.documentElement.getAttribute('data-theme') === 'light';
        document.querySelectorAll('[data-theme-toggle]').forEach(function (el) {
          el.textContent = light ? '☾' : '☀';
        });
      })();
    </script>
  </body>
</html>
