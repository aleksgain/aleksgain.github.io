---
// Fetch GitHub stats using the GitHub API
const username = 'aleksgain';
const response = await fetch(`https://api.github.com/users/${username}`);
const userData = await response.json();

// Fetch recent repositories
const reposResponse = await fetch(`https://api.github.com/users/${username}/repos?sort=updated&per_page=5`);
const recentRepos = await reposResponse.json();
---

<div class="space-y-6">
  <div class="flex items-center gap-4 p-4 bg-gray-50 rounded-lg">
    <img 
      src={userData.avatar_url} 
      alt="GitHub Avatar" 
      class="w-16 h-16 rounded-full"
    />
    <div>
      <p class="font-medium">{userData.public_repos} Public Repositories</p>
      <p class="text-gray-600">{userData.followers} Followers</p>
    </div>
  </div>

  <div class="space-y-4">
    <h3 class="text-lg font-medium">Recent Activity</h3>
    <div class="space-y-2">
      {recentRepos.map((repo: any) => (
        <a 
          href={repo.html_url}
          target="_blank"
          rel="noopener noreferrer"
          class="block p-3 border rounded hover:bg-gray-50 transition-colors"
        >
          <p class="font-medium">{repo.name}</p>
          <p class="text-sm text-gray-600">{repo.description}</p>
          <div class="text-sm text-gray-500 mt-1">
            Last updated: {new Date(repo.updated_at).toLocaleDateString()}
          </div>
        </a>
      ))}
    </div>
  </div>
</div> 