---
import personalData from '../data/personal.json';
---

<div id="github-stats" class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 transition-colors">
  <div class="animate-pulse bg-gray-200 dark:bg-gray-700 h-6 w-24 mb-2 mx-auto rounded"></div>
  <p class="text-sm text-gray-600 dark:text-gray-400">GitHub Contributions</p>
</div>

<script>
  const username = '{personalData.githubUsername}';
  const token = import.meta.env.PUBLIC_GITHUB_TOKEN;

  async function fetchGitHubStats() {
    try {
      const response = await fetch('https://api.github.com/graphql', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          query: `query($userName:String!) {
            user(login: $userName) {
              contributionsCollection {
                totalCommitContributions
              }
            }
          }`,
          variables: { userName: username }
        })
      });

      if (response.ok) {
        const data = await response.json();
        const commits = data.data.user.contributionsCollection.totalCommitContributions;
        const statsDiv = document.getElementById('github-stats');
        if (statsDiv) {
          statsDiv.innerHTML = `
            <p class="text-2xl font-bold">${commits}</p>
            <p class="text-sm text-gray-600 dark:text-gray-400">GitHub Contributions</p>
          `;
        }
      }
    } catch (e) {
      console.error('Error fetching GitHub stats:', e);
    }
  }

  // Fetch stats when the component mounts
  fetchGitHubStats();
</script> 