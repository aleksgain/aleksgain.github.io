---
// Component Script
---

<div id="github-stats" class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6 transition-colors">
  <div class="animate-pulse space-y-2">
    <div class="h-8 w-32 bg-gradient-to-r from-gray-200 via-gray-300 to-gray-200 dark:from-gray-700 dark:via-gray-600 dark:to-gray-700 rounded mx-auto"></div>
    <div class="h-4 w-48 bg-gradient-to-r from-gray-200 via-gray-300 to-gray-200 dark:from-gray-700 dark:via-gray-600 dark:to-gray-700 rounded mx-auto"></div>
  </div>
</div>

<script is:inline>
  async function fetchGitHubStats() {
    try {
      // Add cache-busting query parameter and no-cache headers
      const response = await fetch('/api/github-stats.json?' + new Date().getTime(), {
        headers: {
          'Cache-Control': 'no-cache, no-store, must-revalidate',
          'Pragma': 'no-cache',
          'Expires': '0'
        }
      });
      
      if (response.ok) {
        const data = await response.json();
        const commits = data.data.user.contributionsCollection.totalCommitContributions;
        const statsDiv = document.getElementById('github-stats');
        if (statsDiv) {
          // Add a subtle loading animation
          statsDiv.classList.add('opacity-50');
          statsDiv.innerHTML = `
            <p class="text-2xl font-bold">${commits}</p>
            <p class="text-sm text-gray-600 dark:text-gray-400">Contributions within the last year</p>
          `;
          // Remove loading state after a short delay
          setTimeout(() => statsDiv.classList.remove('opacity-50'), 300);
        }
      }
    } catch (e) {
      console.error('Error fetching GitHub stats:', e);
    }
  }

  // Fetch stats when the component mounts
  fetchGitHubStats();
  
  // Set up periodic refresh every 5 minutes
  const REFRESH_INTERVAL = 5 * 60 * 1000; // 5 minutes in milliseconds
  setInterval(fetchGitHubStats, REFRESH_INTERVAL);
</script> 