---
import certifications from '../data/certifications.json';
const { badges } = certifications;
---

<div class="grid grid-cols-2 gap-4">
  {badges.map((badge) => (
    <div class="border rounded-lg p-4">
      <a 
        href={badge.url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="block"
      >
        <img
          src={badge.image_url}
          alt={badge.name}
          width="100"
          height="100"
          class="mx-auto"
        />
        <h3 class="text-center mt-2 font-medium">{badge.name}</h3>
      </a>
    </div>
  ))}
</div> 