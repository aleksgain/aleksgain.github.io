---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import personalData from '../data/personal.json';
import certifications from '../data/certifications.json';
import { marked } from 'marked';
import fs from 'node:fs';

// Calculate career metrics
const careerStartYear = personalData.graduationYear - 1;
const currentYear = new Date().getFullYear();
const yearsInTech = currentYear - careerStartYear;
const certCount = certifications.badges.length;

// Format phone number for tel: link
const formattedPhone = personalData.phone.replace(/[\s()-]/g, '');

// Construct social URLs
const socialUrls = {
  linkedIn: `https://www.linkedin.com/in/${personalData.linkedInUsername}`,
  github: `https://github.com/${personalData.githubUsername}`
};

// Read the markdown template
const template = fs.readFileSync('src/resume.md', 'utf-8');

// Replace placeholders with actual data
const markdown = template
  .replace(/{{email}}/g, personalData.email)
  .replace(/{{phone}}/g, personalData.phone)
  .replace(/{{phoneFormatted}}/g, formattedPhone)
  .replace(/{{linkedInUsername}}/g, personalData.linkedInUsername)
  .replace(/{{linkedInUrl}}/g, socialUrls.linkedIn)
  .replace(/{{githubUsername}}/g, personalData.githubUsername)
  .replace(/{{yearsInTech}}/g, yearsInTech)
  .replace(/{{certCount}}/g, certCount);

// Parse markdown to HTML
const content = marked(markdown);

// SEO metadata
const pageTitle = "Alex Gain - Professional Resume";
const pageDescription = `Senior Cloud Engineer with ${yearsInTech}+ years of experience and ${certCount} cloud certifications. Expertise in AWS, GCP, Kubernetes, and DevSecOps.`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  type="profile"
  canonicalUrl={`${Astro.url.origin}/resume`}
>
  <div class="print:hidden">
    <ThemeToggle />
    <ScrollToTop />
  </div>
  <main class="min-h-screen p-4 sm:p-6 md:p-12 lg:p-24 print:p-8">
    <div class="max-w-4xl mx-auto">
      <div id="avatar-container" class="flex justify-center mb-8 print:hidden">
        <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-800 animate-pulse"></div>
      </div>
      <div class="prose dark:prose-invert prose-lg animate-fade-in print:!prose-neutral print:max-w-none" set:html={content} />
      <div class="mt-8 print:hidden">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-lg transition-all duration-200 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 shadow-md hover:shadow-lg no-underline"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Back to Home</span>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  @media print {
    html {
      font-size: 12px;
    }
    
    @page {
      margin: 1.5cm;
    }
  }
</style>

<script is:inline>
  async function fetchAvatar() {
    try {
      const response = await fetch('/api/github-avatar.json');
      if (response.ok) {
        const data = await response.json();
        const avatarUrl = data.data.user.avatarUrl;
        const container = document.getElementById('avatar-container');
        if (container && avatarUrl) {
          container.innerHTML = `
            <img 
              src="${avatarUrl}" 
              alt="Alex Gain" 
              class="w-32 h-32 rounded-full shadow-lg animate-bounce-in"
            />
          `;
        }
      }
    } catch (e) {
      console.error('Error fetching GitHub avatar:', e);
    }
  }

  // Fetch avatar when the page loads
  fetchAvatar();
</script> 