---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import personalData from '../data/personal.json';
import certifications from '../data/certifications.json';
import { marked } from 'marked';
import { yearsInTech as calcYears } from '../data/career';
import fs from 'node:fs';

// Calculate career metrics
const yearsInTech = calcYears();
const certCount = certifications.badges.length;

// Format phone number for tel: link
const formattedPhone = personalData.phone.replace(/[\s()-]/g, '');

// Construct social URLs
const socialUrls = {
  linkedIn: `https://www.linkedin.com/in/${personalData.linkedInUsername}`,
  github: `https://github.com/${personalData.githubUsername}`,
};

// Read the markdown template
const template = fs.readFileSync('src/resume.md', 'utf-8');

// Replace placeholders with actual data
const markdown = template
  .replace(/{{email}}/g, personalData.email)
  .replace(/{{phone}}/g, personalData.phone)
  .replace(/{{phoneFormatted}}/g, formattedPhone)
  .replace(/{{linkedInUsername}}/g, personalData.linkedInUsername)
  .replace(/{{linkedInUrl}}/g, socialUrls.linkedIn)
  .replace(/{{githubUsername}}/g, personalData.githubUsername)
  .replace(/{{yearsInTech}}/g, yearsInTech)
  .replace(/{{certCount}}/g, certCount);

// Parse markdown to HTML
const content = marked(markdown);

// SEO metadata
const pageTitle = 'Alex Gain - Professional Resume';
const pageDescription = `Senior Cloud Engineer with ${yearsInTech}+ years of experience and ${certCount} cloud certifications. Expertise in AWS, Azure, Google Cloud, Kubernetes, FinOps and cloud security.`;
---

<Base
  title={pageTitle}
  description={pageDescription}
  type="profile"
  canonicalUrl={`${Astro.url.origin}/resume`}
>
  <TopBar home />
  <div class="no-print"><ScrollToTop /></div>

  <div class="shell--narrow">
    <div class="resume-tools no-print">
      <button type="button" class="resume-tools__print" data-print aria-label="Print or save as PDF">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6"/><rect x="6" y="14" width="12" height="7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/></svg>
        Print / PDF
      </button>
    </div>

    <div class="resume-head no-print">
      <img
        src={`https://github.com/${personalData.githubUsername}.png`}
        alt="Alex Gain"
        width="96"
        height="96"
        class="resume-head__avatar"
      />
    </div>

    <article class="doc" set:html={content} />

    <div class="resume-foot no-print">
      <a href="/" class="resume-foot__back">← Back</a>
      <a href={`mailto:${personalData.email}`} class="resume-foot__mail mono">{personalData.email}</a>
    </div>
  </div>
</Base>

<script is:inline>
  document.querySelectorAll('[data-print]').forEach(function (b) {
    b.addEventListener('click', function () { window.print(); });
  });
</script>

<style>
  .resume-head { display: flex; justify-content: center; margin-bottom: 28px; }
  .resume-head__avatar {
    width: 96px; height: 96px; border-radius: 50%;
    object-fit: cover; border: 2px solid var(--line2); background: var(--card2);
  }

  /* Token-based document typography for the rendered resume markdown. */
  .doc { color: var(--ink2); font-size: 15.5px; line-height: 1.65; }
  .doc :global(h1) {
    margin: 0 0 6px; font: 900 34px/1.1 Lato, sans-serif;
    letter-spacing: -1px; color: var(--ink); text-wrap: balance;
  }
  .doc :global(h2) {
    margin: 36px 0 12px; padding-bottom: 8px;
    font: 900 15px/1.2 "JetBrains Mono", monospace;
    letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink3); border-bottom: 1px solid var(--line);
  }
  .doc :global(h3) {
    margin: 22px 0 6px; font: 700 18px/1.3 Lato, sans-serif;
    letter-spacing: -.3px; color: var(--ink);
  }
  .doc :global(h4) { margin: 16px 0 4px; font: 700 15px Lato, sans-serif; color: var(--ink); }
  .doc :global(p) { margin: 0 0 12px; }
  .doc :global(ul), .doc :global(ol) { margin: 0 0 14px; padding-left: 20px; }
  .doc :global(ul) { list-style: disc; }
  .doc :global(ol) { list-style: decimal; }
  .doc :global(li) { margin: 5px 0; }
  .doc :global(li::marker) { color: var(--ink3); }
  .doc :global(strong) { color: var(--ink); font-weight: 700; }
  .doc :global(em) { color: var(--ink3); font-style: normal; font-family: "JetBrains Mono", monospace; font-size: 13px; }
  .doc :global(hr) { margin: 28px 0; border: 0; border-top: 1px solid var(--line); }
  .doc :global(code) {
    font: 400 13px "JetBrains Mono", monospace;
    background: var(--card2); border: 1px solid var(--line);
    border-radius: 5px; padding: 1px 5px; color: var(--ink);
  }
  .doc :global(blockquote) {
    margin: 0 0 14px; padding-left: 14px;
    border-left: 3px solid var(--line2); color: var(--ink3);
  }
  .doc :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 16px; font-size: 14px; }
  .doc :global(th), .doc :global(td) { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); }
  .doc :global(th) { color: var(--ink); font-weight: 700; }

  .resume-foot {
    margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--line);
    display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
  }
  .resume-foot__back { font: 700 14px Lato, sans-serif; color: var(--ink2); }
  .resume-foot__back:hover { color: var(--accent); }
  .resume-foot__mail { font: 400 12px "JetBrains Mono", monospace; color: var(--ink3); }

  /* Short lists straight under a section heading (certs, skills) go two-up. */
  @media (min-width: 700px) {
    .doc :global(h2 + ul) { columns: 2; column-gap: 32px; }
    .doc :global(h2 + ul li) { break-inside: avoid; margin-top: 0; }
  }

  .resume-tools { display: flex; justify-content: flex-end; margin-bottom: 8px; }
  .resume-tools__print {
    display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
    font: 700 13px Lato, sans-serif; color: var(--ink2);
    background: var(--card); border: 1px solid var(--line2);
    border-radius: 8px; padding: 7px 12px;
  }
  .resume-tools__print:hover { color: var(--ink); border-color: var(--accent); }

  /* Print: interface-free, black on white, system fonts every printer/PDF
     engine has, A4 with US-Letter-safe margins. Applies to Ctrl+P too. */
  @media print {
    @page { size: A4; margin: 14mm 15mm; }
    :global(html), :global(body) { background: #fff !important; }
    :global(html) {
      --ink: #000; --ink2: #111; --ink3: #444; --line: #bbb; --line2: #999; --link: #000;
    }
    .doc, .doc :global(*) {
      font-family: Arial, Helvetica, "Liberation Sans", sans-serif !important;
      color: #000 !important;
    }
    .doc { font-size: 10pt; line-height: 1.38; }
    .doc :global(h1) { font-size: 20pt; font-weight: 700; letter-spacing: 0; margin-bottom: 2pt; }
    .doc :global(h1 + p) { margin-bottom: 4pt; }
    .doc :global(h2) {
      font-size: 10.5pt; font-weight: 700; letter-spacing: .06em;
      margin: 12pt 0 5pt; padding-bottom: 2pt; border-bottom: 0.75pt solid #000;
      break-after: avoid;
    }
    .doc :global(h3) { font-size: 11pt; margin: 9pt 0 1pt; break-after: avoid; }
    .doc :global(h3 + p) { break-after: avoid; }
    .doc :global(em) { font-size: 9.5pt; font-style: italic; color: #333 !important; }
    .doc :global(p) { margin: 0 0 5pt; }
    .doc :global(ul) { margin: 0 0 6pt; padding-left: 14pt; }
    .doc :global(li) { margin: 1.5pt 0; break-inside: avoid; }
    .doc :global(a) { text-decoration: none; }
    .doc :global(code) { background: none; border: 0; padding: 0; }
    .doc :global(h2 + ul) { columns: 2; column-gap: 18pt; }
  }
</style>
