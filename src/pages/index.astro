---
import Layout from '../layouts/Layout.astro';
import SocialBar from '../components/SocialBar.astro';
import CredlyBadges from '../components/CredlyBadges.astro';
import GithubStats from '../components/GithubStats.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import certifications from '../data/certifications.json';
import skillsData from '../data/skills.json';
import personalData from '../data/personal.json';

// Calculate career metrics
const careerStartYear = personalData.graduationYear - 1;
const currentYear = new Date().getFullYear();
const yearsInTech = currentYear - careerStartYear;

// Fetch GitHub avatar
const username = personalData.githubUsername;
const token = import.meta.env.PUBLIC_GITHUB_TOKEN;

// Get the number of certifications
const certCount = certifications.badges.length;

let avatarUrl = null;
try {
  const response = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${token}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      query: `query($userName:String!) { 
        user(login: $userName){
          avatarUrl
        }
      }`,
      variables: { userName: username }
    })
  });

  if (response.ok) {
    const data = await response.json();
    avatarUrl = data.data.user.avatarUrl;
  }
} catch (e) {
  console.error('Error fetching GitHub avatar:', e);
}
---

<Layout title="Alex Gain">
  <ThemeToggle />
  <main class="min-h-screen p-8 md:p-24">
    <div class="max-w-4xl mx-auto animate-fade-in">
      <div class="flex items-center gap-6 mb-8">
        {avatarUrl && (
          <img 
            src={avatarUrl} 
            alt="Alex Gain" 
            class="w-24 h-24 rounded-full shadow-lg animate-bounce-in"
          />
        )}
        <div>
          <h1 class="text-4xl font-bold mb-4">
            Hi, I'm Alex
          </h1>
          <p class="text-xl mb-4">
            And I'm good at running stuff in the cloud
          </p>
        </div>
      </div>
      
      <div class="flex gap-4 mb-8 text-blue-600">
        <a 
          href={`https://www.linkedin.com/in/${personalData.linkedInUsername}/recent-activity/all/`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-blue-800 transition-colors"
        >
          View my LinkedIn Activity →
        </a>
        <span class="text-gray-300">|</span>
        <a 
          href="/resume"
          class="hover:text-blue-800 transition-colors"
        >
          View Resume →
        </a>
        <span class="text-gray-300">|</span>
        <a 
          href={`mailto:${personalData.email}`}
          class="hover:text-blue-800 transition-colors"
        >
          Get in touch →
        </a>
      </div>
      
      <SocialBar />
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 my-16 text-center animate-slide-up">
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 transition-colors">
          <p class="text-2xl font-bold">{yearsInTech}+</p>
          <p class="text-sm text-gray-600 dark:text-gray-400">Years in Tech</p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 transition-colors">
          <p class="text-2xl font-bold">{certCount}+</p>
          <p class="text-sm text-gray-600 dark:text-gray-400">Cloud Certifications</p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 transition-colors">
          <p class="text-2xl font-bold">{personalData.cloudPlatforms}</p>
          <p class="text-sm text-gray-600 dark:text-gray-400">Cloud Platforms</p>
        </div>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-4 transition-colors">
          <p class="text-2xl font-bold">∞</p>
          <p class="text-sm text-gray-600 dark:text-gray-400">Problems Solved</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
        <section>
          <h2 class="text-2xl font-semibold mb-4">Certifications</h2>
          <CredlyBadges />
        </section>
        
        <section>
          <h2 class="text-2xl font-semibold mb-4">GitHub Activity</h2>
          <GithubStats />
        </section>
      </div>

      <div class="flex flex-wrap gap-2 mt-16 animate-slide-up">
        {skillsData.skills.flatMap(category => 
          category.items.map(skill => (
          <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm transition-colors hover:scale-105">
            {skill}
          </span>
        )))}
      </div>
    </div>
  </main>
</Layout> 