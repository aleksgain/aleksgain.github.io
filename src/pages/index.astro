---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SocialBar from '../components/SocialBar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { categoryStyles } from '../data/blogCategories';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const INITIAL_BATCH = 15;

const pageTitle = "Alex Gain — The Wire";
const pageDescription = "Dev, Sec, Ops, Infra, Cloud and AI links worth your time, picked daily by Alex Gain, Senior Cloud Engineer & DevSecOps Specialist.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  type="website"
>
  <ThemeToggle />
  <ScrollToTop />

  <header class="sticky top-0 z-40 backdrop-blur-md bg-white/85 dark:bg-gray-900/85 border-b border-gray-200 dark:border-gray-800">
    <div class="max-w-2xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
      <a href="/about" class="flex items-center gap-3 group min-w-0">
        <div id="avatar-container" class="w-10 h-10 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-800 flex-shrink-0"></div>
        <div class="leading-tight min-w-0">
          <p class="font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate">Alex Gain</p>
          <p class="text-xs text-gray-500 dark:text-gray-400 truncate">Cloud Engineer &amp; DevSecOps</p>
        </div>
      </a>
      <div class="flex items-center gap-1 sm:gap-3 flex-shrink-0">
        <a href="/about" class="hidden sm:inline text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 px-1">About</a>
        <a href="/resume" class="hidden sm:inline text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 px-1">Resume</a>
        <SocialBar />
      </div>
    </div>
  </header>

  <main class="max-w-2xl mx-auto px-4 py-6">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">The Wire</h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Dev, Sec, Ops, Infra, Cloud and AI links worth your time, picked daily.</p>
    </div>

    {posts.length === 0 && (
      <p class="text-center text-gray-500 dark:text-gray-400 py-20">No posts yet &mdash; check back soon.</p>
    )}

    <div class="flex flex-col gap-4">
      {posts.map((post, i) => (
        <article data-feed-item hidden={i >= INITIAL_BATCH ? true : undefined} class="bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl p-4 sm:p-5 border border-gray-200 dark:border-gray-700 shadow-sm">
          <div class="flex flex-wrap items-center gap-2 mb-2 text-xs">
            <span class={`px-2 py-0.5 rounded-full font-semibold uppercase tracking-wide ${categoryStyles[post.data.category]}`}>
              {post.data.category}
            </span>
            <span class="text-gray-500 dark:text-gray-400">{post.data.source}</span>
            <span class="text-gray-400 dark:text-gray-500">&middot;</span>
            <time class="text-gray-500 dark:text-gray-400" datetime={post.data.pubDate.toISOString()}>
              {dateFmt.format(post.data.pubDate)}
            </time>
            <a href={`/blog/${post.slug}/`} class="ml-auto text-gray-400 hover:text-blue-600 dark:hover:text-blue-400" aria-label="Permalink" title="Permalink">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
            </a>
          </div>
          <p class="whitespace-pre-line text-gray-800 dark:text-gray-100 leading-relaxed">{post.body.trim()}</p>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-3">
              {post.data.tags.map(tag => (
                <span class="text-xs text-gray-500 dark:text-gray-400">#{tag}</span>
              ))}
            </div>
          )}
          <a
            href={post.data.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 mt-3 text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline"
          >
            Read source
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </article>
      ))}
    </div>

    <div id="sentinel" class="h-10"></div>
    <p id="feed-end" hidden class="text-center text-sm text-gray-400 dark:text-gray-500 py-8">You&rsquo;re all caught up.</p>
  </main>
</Layout>

<noscript><style>[data-feed-item]{display:block!important}</style></noscript>

<script is:inline>
  async function fetchAvatar() {
    try {
      const response = await fetch('/api/github-avatar.json');
      if (response.ok) {
        const data = await response.json();
        const avatarUrl = data.data.user.avatarUrl;
        const container = document.getElementById('avatar-container');
        if (container && avatarUrl) {
          container.innerHTML = `<img src="${avatarUrl}" alt="Alex Gain" class="w-10 h-10 rounded-full object-cover" />`;
        }
      }
    } catch (e) {
      console.error('Error fetching GitHub avatar:', e);
    }
  }
  fetchAvatar();

  (function () {
    var BATCH = 15;
    var items = Array.prototype.slice.call(document.querySelectorAll('[data-feed-item][hidden]'));
    var sentinel = document.getElementById('sentinel');
    var endMsg = document.getElementById('feed-end');
    if (!sentinel) return;
    if (!items.length) {
      if (endMsg) endMsg.hidden = false;
      return;
    }
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var next = items.splice(0, BATCH);
        next.forEach(function (el) { el.hidden = false; });
        if (!items.length) {
          observer.disconnect();
          if (endMsg) endMsg.hidden = false;
        }
      });
    }, { rootMargin: '600px' });
    observer.observe(sentinel);
  })();
</script>
