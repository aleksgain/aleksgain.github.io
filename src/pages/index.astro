---
import Layout from '../layouts/Layout.astro';
import SocialBar from '../components/SocialBar.astro';
import CredlyBadges from '../components/CredlyBadges.astro';
import GithubStats from '../components/GithubStats.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import certifications from '../data/certifications.json';
import skillsData from '../data/skills.json';
import personalData from '../data/personal.json';

// Calculate career metrics
const careerStartYear = personalData.graduationYear - 1;
const currentYear = new Date().getFullYear();
const yearsInTech = currentYear - careerStartYear;

// Get the number of certifications
const certCount = certifications.badges.length;

// SEO metadata
const pageTitle = "Alex Gain - Senior Cloud Engineer & DevSecOps Specialist";
const pageDescription = `Senior Cloud Engineer and DevSecOps Specialist with ${yearsInTech}+ years of experience in AWS, GCP, and Azure. Expertise in Kubernetes, Terraform, and Cloud Security.`;
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  type="profile"
>
  <ThemeToggle />
  <ScrollToTop />
  
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-blue-50 via-white to-purple-50 dark:from-gray-900 dark:via-gray-800 dark:to-gray-900">
    <!-- Animated background gradient -->
    <div class="absolute inset-0 bg-gradient-to-r from-blue-600/10 via-purple-600/10 to-pink-600/10 dark:from-blue-500/5 dark:via-purple-500/5 dark:to-pink-500/5 animate-gradient bg-[length:200%_200%]"></div>
    
    <!-- Floating orbs for visual interest -->
    <div class="absolute top-20 left-10 w-72 h-72 bg-blue-400/20 dark:bg-blue-500/10 rounded-full blur-3xl animate-float"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-purple-400/20 dark:bg-purple-500/10 rounded-full blur-3xl animate-float" style="animation-delay: 2s;"></div>
    
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center animate-fade-in">
        <!-- Avatar -->
        <div id="avatar-container" class="flex justify-center mb-8">
          <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-full bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-800 animate-pulse ring-4 ring-white/50 dark:ring-gray-700/50 shadow-2xl"></div>
        </div>
        
        <!-- Main Heading -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 dark:from-blue-400 dark:via-purple-400 dark:to-pink-400 animate-slide-up">
          Hi, I'm <span class="text-gray-900 dark:text-white">Alex</span>
        </h1>
        
        <!-- Tagline with typing effect -->
        <div class="mb-8 animate-slide-up" style="animation-delay: 0.2s;">
          <p class="text-xl sm:text-2xl md:text-3xl font-semibold text-gray-700 dark:text-gray-300 mb-3">
            Senior Cloud Engineer & DevSecOps Specialist
          </p>
          <p class="text-lg sm:text-xl md:text-2xl text-gray-600 dark:text-gray-400 max-w-3xl mx-auto leading-relaxed">
            I'm good at running stuff in the cloud. Do you have questions about your current or future infra? 
            <span class="text-blue-600 dark:text-blue-400 font-medium">Let's talk!</span>
          </p>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-wrap justify-center gap-4 mb-8 animate-slide-up" style="animation-delay: 0.4s;">
          <a 
            href={`mailto:${personalData.email}`}
            class="group inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 dark:from-blue-500 dark:to-purple-500 dark:hover:from-blue-600 dark:hover:to-purple-600 text-white rounded-xl transition-all duration-300 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 shadow-lg hover:shadow-xl font-semibold"
          >
            <span>Get in Touch</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </a>
          <a 
            href="/resume"
            class="group inline-flex items-center gap-2 px-6 py-3 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm hover:bg-white dark:hover:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-xl transition-all duration-300 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 shadow-lg hover:shadow-xl font-semibold border border-gray-200 dark:border-gray-700"
          >
            <span>View Resume</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </a>
          <a 
            href={`https://www.linkedin.com/in/${personalData.linkedInUsername}/recent-activity/all/`}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 px-6 py-3 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm hover:bg-white dark:hover:bg-gray-700 text-gray-900 dark:text-gray-100 rounded-xl transition-all duration-300 hover:scale-110 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900 shadow-lg hover:shadow-xl font-semibold border border-gray-200 dark:border-gray-700"
          >
            <span>LinkedIn</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
        
        <!-- Social Bar -->
        <div class="flex justify-center animate-slide-up" style="animation-delay: 0.6s;">
          <SocialBar />
        </div>
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>
  
  <!-- Main Content -->
  <main class="min-h-screen p-4 sm:p-6 md:p-12 lg:p-24">
    <div class="max-w-4xl mx-auto">
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 my-12 sm:my-16 text-center animate-slide-up">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-gray-800 dark:to-gray-700 rounded-lg p-4 sm:p-6 transition-all duration-300 hover:shadow-lg hover:scale-105 border border-blue-200 dark:border-gray-600">
          <p class="text-2xl sm:text-3xl font-bold text-blue-600 dark:text-blue-400">{yearsInTech}+</p>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1">Years in Tech</p>
        </div>
        <div class="bg-gradient-to-br from-green-50 to-green-100 dark:from-gray-800 dark:to-gray-700 rounded-lg p-4 sm:p-6 transition-all duration-300 hover:shadow-lg hover:scale-105 border border-green-200 dark:border-gray-600">
          <p class="text-2xl sm:text-3xl font-bold text-green-600 dark:text-green-400">{certCount}+</p>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1">Cloud Certifications</p>
        </div>
        <div class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-gray-800 dark:to-gray-700 rounded-lg p-4 sm:p-6 transition-all duration-300 hover:shadow-lg hover:scale-105 border border-purple-200 dark:border-gray-600">
          <p class="text-2xl sm:text-3xl font-bold text-purple-600 dark:text-purple-400">{personalData.cloudPlatforms}</p>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1">Cloud Platforms</p>
        </div>
        <div class="bg-gradient-to-br from-orange-50 to-orange-100 dark:from-gray-800 dark:to-gray-700 rounded-lg p-4 sm:p-6 transition-all duration-300 hover:shadow-lg hover:scale-105 border border-orange-200 dark:border-gray-600">
          <p class="text-2xl sm:text-3xl font-bold text-orange-600 dark:text-orange-400">∞</p>
          <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 mt-1">Problems Solved</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 mt-8 sm:mt-12">
        <section>
          <h2 class="text-2xl font-semibold mb-4">Certifications</h2>
          <CredlyBadges />
        </section>
        
        <section>
          <h2 class="text-2xl font-semibold mb-4">GitHub Activity</h2>
          <GithubStats />
        </section>
      </div>

      <div class="flex flex-wrap gap-2 sm:gap-3 mt-12 sm:mt-16 animate-slide-up">
        {skillsData.skills.flatMap(category => 
          category.items.map(skill => (
          <span class="px-3 py-1.5 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-xs sm:text-sm font-medium transition-all duration-200 hover:scale-110 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1">
            {skill}
          </span>
        )))}
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  async function fetchAvatar() {
    try {
      const response = await fetch('/api/github-avatar.json');
      if (response.ok) {
        const data = await response.json();
        const avatarUrl = data.data.user.avatarUrl;
        const container = document.getElementById('avatar-container');
        if (container && avatarUrl) {
          container.innerHTML = `
            <img 
              src="${avatarUrl}" 
              alt="Alex Gain" 
              class="w-32 h-32 sm:w-40 sm:h-40 rounded-full shadow-2xl ring-4 ring-white/50 dark:ring-gray-700/50 animate-bounce-in"
            />
          `;
        }
      }
    } catch (e) {
      console.error('Error fetching GitHub avatar:', e);
    }
  }

  // Fetch avatar when the page loads
  fetchAvatar();
</script> 
