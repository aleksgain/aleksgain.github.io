---
import Layout from '../layouts/Layout.astro';
import SocialBar from '../components/SocialBar.astro';
import CredlyBadges from '../components/CredlyBadges.astro';
import GithubStats from '../components/GithubStats.astro';
import certifications from '../data/certifications.json';

// Fetch GitHub avatar
const username = 'aleksgain';
const token = import.meta.env.PUBLIC_GITHUB_TOKEN;

// Get the number of certifications
const certCount = certifications.badges.length;

let avatarUrl = null;
try {
  const response = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${token}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      query: `query($userName:String!) { 
        user(login: $userName){
          avatarUrl
        }
      }`,
      variables: { userName: username }
    })
  });

  if (response.ok) {
    const data = await response.json();
    avatarUrl = data.data.user.avatarUrl;
  }
} catch (e) {
  console.error('Error fetching GitHub avatar:', e);
}
---

<Layout title="Alex Gain">
  <main class="min-h-screen p-8 md:p-24">
    <div class="max-w-4xl mx-auto">
      <div class="flex items-center gap-6 mb-8">
        {avatarUrl && (
          <img 
            src={avatarUrl} 
            alt="Alex Gain" 
            class="w-24 h-24 rounded-full shadow-lg"
          />
        )}
        <div>
          <h1 class="text-4xl font-bold mb-4">
            Hi, I'm Alex
          </h1>
          <p class="text-xl mb-4">
            And I'm good at running stuff in the cloud
          </p>
        </div>
      </div>
      
      <div class="flex gap-4 mb-8 text-blue-600">
        <a 
          href="https://www.linkedin.com/in/alex-gain/recent-activity/all/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-blue-800 transition-colors"
        >
          View my LinkedIn Activity →
        </a>
        <span class="text-gray-300">|</span>
        <a 
          href="mailto:alex@alexkri.net"
          class="hover:text-blue-800 transition-colors"
        >
          Get in touch →
        </a>
      </div>
      
      <SocialBar />
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 my-16 text-center">
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-2xl font-bold">15+</p>
          <p class="text-sm text-gray-600">Years in Tech</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-2xl font-bold">{certCount}</p>
          <p class="text-sm text-gray-600">Cloud Certifications</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-2xl font-bold">3</p>
          <p class="text-sm text-gray-600">Cloud Platforms</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4">
          <p class="text-2xl font-bold">∞</p>
          <p class="text-sm text-gray-600">Problems Solved</p>
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
        <section>
          <h2 class="text-2xl font-semibold mb-4">Certifications</h2>
          <CredlyBadges />
        </section>
        
        <section>
          <h2 class="text-2xl font-semibold mb-4">GitHub Activity</h2>
          <GithubStats />
        </section>
      </div>

      <div class="flex flex-wrap gap-2 mt-16">
        {[
          'AWS', 'GCP', 'Kubernetes', 'Terraform', 'Docker', 
          'CI/CD', 'DevOps', 'Cloud Security', 'Infrastructure as Code',
          'Python', 'Node.js', 'Monitoring', 'Observability',
          'Zero Trust', 'FinOps', 'SRE'
        ].map(skill => (
          <span class="px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </main>
</Layout> 