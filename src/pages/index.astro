---
// src/pages/index.astro — the unified main page: identity + News in one view.
// Replaces the old split between / (feed) and /about (stats, certs, resume links).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import IdentityPanel from '../components/IdentityPanel.astro';
import WireFeed from '../components/WireFeed.astro';
import ScrollToTop from '../components/ScrollToTop.astro';

const entries = await getCollection('blog');

const posts = await Promise.all(
  entries
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .map(async (entry) => {
      const { Content } = await entry.render();
      return {
        slug: entry.slug,
        title: entry.data.title,
        category: entry.data.category,
        source: entry.data.source,
        sourceUrl: entry.data.sourceUrl,
        pubDate: entry.data.pubDate,
        tags: entry.data.tags,
        Content,
      };
    })
);

const pageTitle = 'Alex Gain — News';
const pageDescription =
  'Dev, Sec, Ops, Infra, Cloud and AI news worth checking, curated by Alex Gain, Senior Cloud Engineer & DevSecOps Specialist.';
---
<Base title={pageTitle} description={pageDescription} type="website">
  <TopBar />
  <ScrollToTop />

  <div class="shell">
    <IdentityPanel />
    <WireFeed posts={posts} />
  </div>
</Base>
