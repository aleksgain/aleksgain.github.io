---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import { categoryStyles } from '../../data/blogCategories';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Layout
  title="The Wire - Alex Gain"
  description="Dev, Sec, Ops, Infra, Cloud and AI links worth your time, picked daily."
  canonicalUrl={`${Astro.url.origin}/blog`}
>
  <ThemeToggle />
  <ScrollToTop />

  <main class="min-h-screen p-4 sm:p-6 md:p-12 lg:p-24">
    <div class="max-w-3xl mx-auto">
      <header class="mb-10 sm:mb-14">
        <h1 class="text-4xl sm:text-5xl font-bold mb-3 bg-clip-text text-transparent bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 dark:from-blue-400 dark:via-purple-400 dark:to-pink-400">
          The Wire
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          Dev, Sec, Ops, Infra, Cloud and AI links worth your time, picked daily.
        </p>
      </header>

      {posts.length === 0 && (
        <p class="text-gray-500 dark:text-gray-400">No posts yet — check back soon.</p>
      )}

      <div class="flex flex-col gap-5 sm:gap-6">
        {posts.map(post => (
          <a
            href={`/blog/${post.slug}/`}
            class="group block bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-xl p-5 sm:p-6 border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5"
          >
            <div class="flex flex-wrap items-center gap-2 mb-2 text-xs">
              <span class={`px-2.5 py-1 rounded-full font-semibold uppercase tracking-wide ${categoryStyles[post.data.category]}`}>
                {post.data.category}
              </span>
              <span class="text-gray-500 dark:text-gray-400">{post.data.source}</span>
              <span class="text-gray-400 dark:text-gray-500">·</span>
              <time class="text-gray-500 dark:text-gray-400" datetime={post.data.pubDate.toISOString()}>
                {dateFmt.format(post.data.pubDate)}
              </time>
            </div>
            <h2 class="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {post.data.title}
            </h2>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
