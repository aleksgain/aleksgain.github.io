---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import { categoryStyles } from '../../data/blogCategories';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

const dateFmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Layout
  title={`${post.data.title} - The Wire`}
  description={post.data.title}
  canonicalUrl={`${Astro.url.origin}/blog/${post.slug}/`}
>
  <ThemeToggle />
  <ScrollToTop />

  <main class="min-h-screen p-4 sm:p-6 md:p-12 lg:p-24">
    <article class="max-w-3xl mx-auto">
      <a href="/blog" class="inline-flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 mb-8 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        The Wire
      </a>

      <div class="flex flex-wrap items-center gap-2 mb-3 text-xs">
        <span class={`px-2.5 py-1 rounded-full font-semibold uppercase tracking-wide ${categoryStyles[post.data.category]}`}>
          {post.data.category}
        </span>
        <span class="text-gray-500 dark:text-gray-400">{post.data.source}</span>
        <span class="text-gray-400 dark:text-gray-500">·</span>
        <time class="text-gray-500 dark:text-gray-400" datetime={post.data.pubDate.toISOString()}>
          {dateFmt.format(post.data.pubDate)}
        </time>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold mb-6 text-gray-900 dark:text-white text-balance">
        {post.data.title}
      </h1>

      <div class="prose dark:prose-invert prose-lg max-w-none">
        <Content />
      </div>

      <div class="mt-10 pt-6 border-t border-gray-200 dark:border-gray-700 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map(tag => (
            <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300">
              #{tag}
            </span>
          ))}
        </div>
        <a
          href={post.data.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline"
        >
          Read the source
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      </div>
    </article>
  </main>
</Layout>
